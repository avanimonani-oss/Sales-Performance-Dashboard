    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"Product_Name", type text}, {"Category", type text}, {"Sub_Category", type text}})
in
    ChangedTypes
